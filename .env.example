# Alt mı Üst mü? — environment variables.
# Local dev reads these from your shell (or appsettings.Development.json); on Railway set them in the service's
# "Variables" tab. Never commit a real .env file.

# PostgreSQL. Railway injects this automatically when you reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Accepts the URI form (postgres://user:pass@host:port/db) or a plain Npgsql connection string.
DATABASE_URL=postgres://altmiustmu:altmiustmu@localhost:5432/altmiustmu

# Public base URL used in emails (confirmation / password reset links) and Open Graph tags. No trailing slash.
APP_URL=https://altmiustmu.up.railway.app

# Resend (https://resend.com) API key. If empty, emails are NOT sent; their content and links are logged instead.
RESEND_API_KEY=

# Sender shown in emails. The domain must be verified in Resend (onboarding@resend.dev only works for your own address).
EMAIL_FROM=Alt mı Üst mü? <bildirim@ornek-alanadi.com>

# Shared secret for POST /api/cron/sync (send it in the X-Cron-Secret header). Empty = endpoint disabled (404).
CRON_SECRET=change-me-to-a-long-random-string

# Admin account created/ensured by `dotnet AltMiUstMu.Web.dll seed`. Password: min 8 chars, a lowercase letter and a digit.
ADMIN_EMAIL=admin@ornek.com
ADMIN_PASSWORD=change-me-123

# Optional
# PORT=8080                          # Railway sets this; the app binds to 0.0.0.0:$PORT
# ASPNETCORE_ENVIRONMENT=Production  # set automatically by Railpack on Railway; seed-demo refuses to run in Production
# SKIP_MIGRATIONS=false              # true = do not auto-migrate on web startup (use the `migrate` command instead)
