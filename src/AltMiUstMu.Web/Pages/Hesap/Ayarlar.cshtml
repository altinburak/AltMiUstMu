@page "/hesap/ayarlar"
@model AltMiUstMu.Web.Pages.Hesap.AyarlarModel
@{
    ViewData["Title"] = T("Hesap ayarları", "Account settings");
}
<div class="container-app max-w-2xl! py-8">
    <p class="eyebrow">@T("Hesap", "Account")</p>
    <h1 class="h1 mt-1">@T("Ayarlar", "Settings")</h1>
    <p class="muted mt-1">@Model.Email</p>

    <form method="post" asp-page-handler="Name" class="card card-pad mt-6 space-y-4" novalidate>
        <h2 class="h2">@T("Kullanıcı adı", "Username")</h2>
        <div>
            <label asp-for="Name.DisplayName" class="label"></label>
            <input asp-for="Name.DisplayName" class="input" maxlength="20" autocomplete="nickname" />
            <p class="mt-1 text-xs muted">@T("Profil bağlantın da değişir: /oyuncu/<kullanıcı adı>", "Your profile link changes too: /oyuncu/<username>")</p>
            <span asp-validation-for="Name.DisplayName" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">@T("Kaydet", "Save")</button>
    </form>

    <form method="post" asp-page-handler="Language" class="card card-pad mt-6 space-y-4">
        <div>
            <h2 class="h2">@T("Dil", "Language")</h2>
            <p class="mt-1 text-sm muted">@T("Site bu dilde açılır. Çıkış yaptığında da bu tarayıcıda hatırlanır.", "The site opens in this language. This browser remembers it after you sign out, too.")</p>
        </div>
        <partial name="_LanguagePicker" model='("Language", Model.Language)' />
        <button type="submit" class="btn btn-primary">@T("Kaydet", "Save")</button>
    </form>

    <form method="post" asp-page-handler="Password" class="card card-pad mt-6 space-y-4" novalidate>
        <h2 class="h2">@T("Şifre değiştir", "Change password")</h2>
        <div>
            <label asp-for="Password.Current" class="label"></label>
            <input asp-for="Password.Current" class="input" autocomplete="current-password" />
            <span asp-validation-for="Password.Current" class="field-error"></span>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="Password.New" class="label"></label>
                <input asp-for="Password.New" class="input" autocomplete="new-password" />
                <span asp-validation-for="Password.New" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Password.Confirm" class="label"></label>
                <input asp-for="Password.Confirm" class="input" autocomplete="new-password" />
                <span asp-validation-for="Password.Confirm" class="field-error"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-secondary">@T("Şifreyi güncelle", "Update password")</button>
    </form>
</div>
