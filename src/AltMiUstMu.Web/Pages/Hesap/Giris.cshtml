@page "/hesap/giris"
@model AltMiUstMu.Web.Pages.Hesap.GirisModel
@{
    ViewData["Title"] = "Giriş yap";
    Layout = "_AuthLayout";
}
<h1 class="h1 text-center">Tekrar hoş geldin</h1>
<p class="muted mt-2 text-center">Tahminlerine kaldığın yerden devam et.</p>

<form method="post" class="mt-6 space-y-4" novalidate>
    <partial name="_FormErrors" />
    @if (Model.ShowResendLink)
    {
        <p class="-mt-2 text-sm"><a href="/hesap/onay-gonder?email=@Uri.EscapeDataString(Model.Input.Email)" class="font-semibold text-brand-600 hover:underline dark:text-brand-400">Doğrulama e-postasını tekrar gönder</a></p>
    }
    <input type="hidden" asp-for="ReturnUrl" />
    <div>
        <label asp-for="Input.Email" class="label"></label>
        <input asp-for="Input.Email" class="input" autocomplete="username" inputmode="email" required autofocus />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>
    <div>
        <div class="flex items-center justify-between">
            <label asp-for="Input.Password" class="label"></label>
            <a href="/hesap/sifremi-unuttum" class="mb-1.5 text-xs font-semibold text-brand-600 hover:underline dark:text-brand-400">Şifremi unuttum</a>
        </div>
        <input asp-for="Input.Password" class="input" autocomplete="current-password" required />
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>
    <label class="flex items-center gap-3 text-sm">
        <input asp-for="Input.RememberMe" type="checkbox" class="size-5 rounded accent-brand-500" />
        <span>Beni hatırla</span>
    </label>
    <button type="submit" class="btn btn-primary w-full">Giriş yap</button>
</form>

@section Below {
    <p class="mt-6 text-center text-sm muted">Hesabın yok mu? <a href="/hesap/kayit" class="font-semibold text-brand-600 hover:underline dark:text-brand-400">Hemen kayıt ol</a></p>
}
