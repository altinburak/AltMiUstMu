@page "/hesap/eposta-onayla"
@model AltMiUstMu.Web.Pages.Hesap.EpostaOnaylaModel
@{
    ViewData["Title"] = "E-posta doğrulama";
    Layout = "_AuthLayout";
}
<div class="text-center">
    @if (Model.Success)
    {
        <div class="mx-auto grid size-14 place-items-center rounded-2xl bg-emerald-500/15 text-3xl" aria-hidden="true">✅</div>
        <h1 class="h1 mt-4">E-postan doğrulandı!</h1>
        <p class="muted mt-3">Hesabın hazır. Şimdi 30 takım için ALT ya da ÜST seçme zamanı.</p>
        <a href="@Model.Next" class="btn btn-primary mt-6 w-full">@(Model.Next.StartsWith("/gruplar/katil/") ? "Gruba katıl" : "Tahminlerime git") @Icons.Svg("arrow-right", "size-4")</a>
    }
    else
    {
        <div class="mx-auto grid size-14 place-items-center rounded-2xl bg-red-500/15 text-3xl" aria-hidden="true">⚠️</div>
        <h1 class="h1 mt-4">Bağlantı geçersiz</h1>
        <p class="muted mt-3">Doğrulama bağlantısı hatalı ya da süresi dolmuş olabilir.</p>
        <a href="/hesap/onay-gonder" class="btn btn-primary mt-6 w-full">Yeni bağlantı gönder</a>
    }
</div>
