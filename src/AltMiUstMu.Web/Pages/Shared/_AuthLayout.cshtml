@{
    Layout = "_Layout";
}
<div class="container-app flex justify-center py-8 sm:py-14">
    <div class="w-full max-w-md">
        <div class="mb-6 flex justify-center">@Icons.Ball("size-12")</div>
        <div class="card card-pad animate-fade-in sm:p-8">
            @RenderBody()
        </div>
        @await RenderSectionAsync("Below", required: false)
    </div>
</div>
@await RenderSectionAsync("Scripts", required: false)
