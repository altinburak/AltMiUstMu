@page "/hata/{code:int}"
@model HataModel
@{
    ViewData["Title"] = Model.Heading;
}
<div class="container-app flex flex-col items-center py-16 text-center sm:py-24">
    <div class="text-6xl" aria-hidden="true">@Model.Emoji</div>
    <p class="mt-6 font-mono text-sm font-bold text-brand-500">@T("HATA", "ERROR") @Model.Code</p>
    <h1 class="h1 mt-2">@Model.Heading</h1>
    <p class="mt-3 max-w-md muted">@Model.Message</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">@T("Ana sayfaya dön", "Back to home")</a>
        @if (Model.Code == 401)
        {
            <a href="/hesap/giris" class="btn btn-secondary">@T("Giriş yap", "Sign in")</a>
        }
        else
        {
            <a href="/liderlik" class="btn btn-secondary">@T("Liderlik tablosu", "Leaderboard")</a>
        }
    </div>
</div>
