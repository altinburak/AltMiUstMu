@page "/takim/{abbr}"
@model TakimModel
@{
    var t = Model.Team;
    ViewData["Title"] = T($"{t.FullName} – barem {Display.Line(t.Line)}", $"{t.FullName} – line {Display.Line(t.Line)}");
    ViewData["Description"] = T(
        $"{t.FullName} sezon galibiyet baremi {Display.Line(t.Line)}. Derece {t.Wins}-{t.Losses}, projeksiyon {Display.Number(t.Projected)}. Topluluk: {(t.TotalPicks == 0 ? "henüz tahmin yok" : Display.Percent(t.OverShare) + " ÜST")}.",
        $"{t.FullName} season win total {Display.Line(t.Line)}. Record {t.Wins}-{t.Losses}, projection {Display.Number(t.Projected)}. Community: {(t.TotalPicks == 0 ? "no picks yet" : Display.Percent(t.OverShare) + " OVER")}.");
    var overStatus = t.StatusFor(PickSide.Over);
    var underShare = 1 - t.OverShare;
    string verdict = overStatus switch
    {
        PickStatus.ClinchedWin => T("Kesinleşti: ÜST kazandı", "Clinched: OVER wins"),
        PickStatus.ClinchedLoss => T("Kesinleşti: ALT kazandı", "Clinched: UNDER wins"),
        PickStatus.TrendingWin => T("Şu an ÜST gidiyor", "Trending OVER"),
        PickStatus.TrendingLoss => T("Şu an ALT gidiyor", "Trending UNDER"),
        PickStatus.Push => T("Tam baremde bitti (push)", "Finished exactly on the line (push)"),
        _ => T("Henüz maç oynanmadı", "No games played yet"),
    };
}
<div class="relative overflow-hidden border-b border-zinc-200 dark:border-ink-800">
    <div class="pointer-events-none absolute inset-0 opacity-20" style="background: radial-gradient(60% 120% at 0% 0%, @t.PrimaryColor, transparent 70%)" aria-hidden="true"></div>
    <div class="container-app relative flex items-center gap-4 py-8 sm:gap-6 sm:py-10">
        @Badges.Team(t, "lg")
        <div class="min-w-0">
            <p class="eyebrow">@Display.ConferenceLabel(t.Conference) · @Display.Division(t.Division)</p>
            <h1 class="h1 mt-1 truncate">@t.FullName</h1>
            <p class="mt-1 font-semibold">@verdict</p>
        </div>
    </div>
</div>

<div class="container-app py-6 sm:py-8">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="card card-pad"><p class="text-xs font-semibold uppercase muted">@T("Barem", "Line")</p><p class="stat mt-1">@Display.Line(t.Line)</p></div>
        <div class="card card-pad"><p class="text-xs font-semibold uppercase muted">@T("Derece", "Record")</p><p class="stat mt-1">@t.Wins-@t.Losses</p></div>
        <div class="card card-pad"><p class="text-xs font-semibold uppercase muted">@T("Projeksiyon", "Projection")</p><p class="stat mt-1 @(t.Projected > t.Line ? "text-brand-500" : t.Projected < t.Line ? "text-sky-500" : "")">@Display.Number(t.Projected)</p></div>
        <div class="card card-pad"><p class="text-xs font-semibold uppercase muted">@T("Kalan maç", "Games left")</p><p class="stat mt-1">@(t.GamesPerTeam - t.GamesPlayed)</p></div>
    </div>

    <div class="card card-pad mt-4">
        <partial name="_WinsBar" model="t" />
        <p class="mt-2 text-xs muted">@T("Dikey çizgi baremi, açık renkli bölüm mevcut tempoyla sezon sonu projeksiyonunu gösterir.", "The vertical line is the win total; the lighter section shows the end-of-season projection at the current pace.")</p>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <section class="card card-pad" aria-labelledby="split">
            <h2 id="split" class="h2">@T("Topluluk ne diyor?", "What does the community say?")</h2>
            @if (t.TotalPicks == 0)
            {
                <p class="mt-3 muted">@T("Bu takım için henüz tahmin yapılmadı.", "No picks for this team yet.")</p>
            }
            else
            {
                <div class="mt-4 flex items-end justify-between">
                    <div><p class="text-3xl font-black text-sky-500 tabular-nums">@Display.Percent(underShare)</p><p class="text-sm font-semibold">@Display.Under</p></div>
                    <div class="text-right"><p class="text-3xl font-black text-brand-500 tabular-nums">@Display.Percent(t.OverShare)</p><p class="text-sm font-semibold">@Display.Over</p></div>
                </div>
                <div class="mt-3 flex h-3 overflow-hidden rounded-full" role="img" aria-label="@Display.Percent(t.OverShare) @Display.Over, @Display.Percent(underShare) @Display.Under">
                    <div class="bg-sky-500" style="width: @Display.Css(underShare * 100)%"></div>
                    <div class="bg-brand-500" style="width: @Display.Css(t.OverShare * 100)%"></div>
                </div>
                <p class="mt-2 text-xs muted">@T($"{t.TotalPicks} oyuncunun tahmini", $"Picks from {t.TotalPicks} players") (@t.UnderCount @Display.Under, @t.OverCount @Display.Over)</p>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mt-5 flex items-center justify-between gap-3 rounded-xl bg-zinc-50 p-3 dark:bg-ink-850">
                    <span class="text-sm">@T("Senin tahminin:", "Your pick:") @Badges.Side(Model.MyPick)</span>
                    @if (Model.MyPick is { } mine && Model.Locked)
                    {
                        @Badges.Status(t.StatusFor(mine))
                    }
                    else if (!Model.Locked)
                    {
                        <a href="/tahminler#pick-@t.Abbreviation" class="text-sm font-semibold text-brand-600 hover:underline dark:text-brand-400">@(Model.MyPick is null ? T("Tahmin yap", "Make a pick") : T("Değiştir", "Change"))</a>
                    }
                </div>
            }
        </section>

        <section class="card card-pad" aria-labelledby="pundits">
            <h2 id="pundits" class="h2">@T("🎙️ Mutfak tahmini", "🎙️ The pundits' picks")</h2>
            <div class="mt-4 grid gap-3">
                @foreach (var p in Model.Pundits)
                {
                    var side = p.Picks.TryGetValue(t.Id, out var s) ? s : (PickSide?)null;
                    <div class="flex items-center gap-3">
                        <span class="grid size-10 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-amber-400 font-black text-white">@Display.Initials(p.DisplayName)</span>
                        <a href="/oyuncu/@Uri.EscapeDataString(p.DisplayName)" class="flex-1 font-semibold hover:underline">@p.DisplayName</a>
                        @Badges.Side(side)
                        @if (side is not null && Model.Locked)
                        {
                            @Badges.Status(t.StatusFor(side.Value))
                        }
                    </div>
                }
                @if (Model.Pundits.Count == 0)
                {
                    <p class="muted">@T("Henüz girilmedi.", "Not entered yet.")</p>
                }
            </div>
        </section>
    </div>

    <a href="/takimlar" class="btn btn-ghost mt-6">← @T("Tüm takımlar", "All teams")</a>
</div>
