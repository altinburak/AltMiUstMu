@page "/takimlar"
@model TakimlarModel
@using System.Globalization
@{
    ViewData["Title"] = "Takımlar";
    ViewData["Description"] = "30 NBA takımının sezon galibiyet baremi, güncel derecesi, projeksiyonu ve topluluğun ALT/ÜST dağılımı.";
    string Inv(decimal? v) => (v ?? 0).ToString(CultureInfo.InvariantCulture);
}
<div class="container-app py-6 sm:py-8">
    <p class="eyebrow">@Model.Season?.Label</p>
    <h1 class="h1 mt-1">Takımlar</h1>
    <p class="muted mt-1">
        Barem, güncel derece, sezon sonu projeksiyonu ve topluluğun tercihi. Sütun başlıklarına dokunarak sırala.
        @if (Model.LastUpdate is { } lu)
        {
            <span>Son güncelleme: @Display.ShortDateTime(lu)</span>
        }
    </p>

    <div class="card mt-6 overflow-hidden" x-data="sortableTable('line', 'desc')">
        <div class="overflow-x-auto">
            <table class="table-app min-w-[640px]">
                <thead class="bg-zinc-50 dark:bg-ink-850">
                    <tr>
                        @foreach (var (key, label, type, css) in new[]
                        {
                            ("name", "Takım", "text", ""),
                            ("conf", "Konf.", "text", "hidden sm:table-cell"),
                            ("line", "Barem", "num", "text-right"),
                            ("wins", "G-M", "num", "text-right"),
                            ("proj", "Proj.", "num", "text-right"),
                            ("diff", "Fark", "num", "text-right"),
                            ("over", "% ÜST", "num", "text-right"),
                        })
                        {
                            <th scope="col" class="@css" x-bind:aria-sort="ariaSort('@key')">
                                <button type="button" class="inline-flex items-center gap-1 font-semibold uppercase hover:text-brand-500" x-on:click="sort('@key', '@type')">
                                    @label
                                    <span x-show="key === '@key'" x-text="dir === 'asc' ? '▲' : '▼'" class="text-brand-500" x-cloak></span>
                                </button>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody x-ref="body">
                    @foreach (var t in Model.Teams.OrderByDescending(t => t.Line))
                    {
                        var diff = t.Projected is { } p ? p - t.Line : (decimal?)null;
                        <tr data-name="@t.FullName" data-conf="@t.Conference" data-line="@Inv(t.Line)" data-wins="@t.Wins" data-proj="@Inv(t.Projected)" data-diff="@Inv(diff)" data-over="@Display.Css(t.OverShare)">
                            <td>
                                <a href="/takim/@t.Abbreviation.ToLowerInvariant()" class="flex items-center gap-3 font-semibold hover:underline">
                                    @Badges.Team(t, "sm")
                                    <span class="truncate">@t.FullName</span>
                                </a>
                            </td>
                            <td class="hidden sm:table-cell muted">@(t.Conference == Conference.East ? "Doğu" : "Batı")</td>
                            <td class="text-right font-bold tabular-nums">@Display.Line(t.Line)</td>
                            <td class="text-right tabular-nums">@t.Wins-@t.Losses</td>
                            <td class="text-right tabular-nums">@Display.Number(t.Projected)</td>
                            <td class="text-right font-semibold tabular-nums @(diff > 0 ? "text-brand-600 dark:text-brand-400" : diff < 0 ? "text-sky-600 dark:text-sky-400" : "muted")">
                                @(diff is null ? "–" : (diff > 0 ? "+" : "") + Display.Number(diff))
                            </td>
                            <td class="text-right">
                                @if (t.TotalPicks == 0)
                                {
                                    <span class="muted">–</span>
                                }
                                else
                                {
                                    <div class="ml-auto flex w-24 items-center gap-2">
                                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-sky-500/40" aria-hidden="true">
                                            <div class="h-full bg-brand-500" style="width: @Display.Css(t.OverShare * 100)%"></div>
                                        </div>
                                        <span class="w-9 text-right text-xs font-semibold tabular-nums">@Display.Percent(t.OverShare)</span>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Teams.Count == 0)
        {
            <p class="p-8 text-center muted">Henüz takım verisi yok.</p>
        }
    </div>
    <p class="mt-3 text-xs muted"><span class="text-brand-500">Turuncu</span> fark ÜST yönünde, <span class="text-sky-500">mavi</span> fark ALT yönünde gidişi gösterir.</p>
</div>
